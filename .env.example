# --- Database ---
# PostgreSQL connection string. Production is Supabase (doc 15 §2.1), used as
# plain Postgres — no Supabase SDK, the connection string is the whole thing.
# Use the SESSION-mode pooler (port 5432). Port 6543 is transaction mode and
# cannot run migrations.
#
# ⚠ Prefer a LOCAL database here. Putting the production string in a developer
# .env means everyone with a checkout holds production — and this database
# stores passports under PDPA (doc 12). Point DATABASE_URL at localhost and let
# the platform's secret store hold production.
DATABASE_URL=postgresql://user:password@localhost:5432/myuno
# Production (Vercel): session pooler, port 5432 — never db.<ref>.supabase.co
# and never port 6543. If a direct URL is set anyway, the app rewrites it at
# runtime (src/lib/resolveDatabaseUrl.ts). Optional override:
# DATABASE_POOLER_HOST=aws-1-ap-south-1.pooler.supabase.com

# Deploys do NOT run migrations (doc 15 §2.4). Bring a database up to date with:
#   DATABASE_URL="<session pooler URL>" node scripts/provision-database.mjs

# --- Test Database ---
# REQUIRED to run tests safely. Must be a separate database from DATABASE_URL.
# Tests will fail fast if this is not set, protecting the live database.
# For local dev: use a local Postgres instance; for CI: point to a test database.
DATABASE_URL_TEST=postgresql://test:test@localhost:5432/myuno_test

# --- Auth / sessions (REQUIRED in production) ---
# Signs session cookies. Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET is accepted as a fallback name; SESSION_SECRET wins.
SESSION_SECRET=change-me-generate-with-openssl-rand
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand
# Base URL used in emailed links (verify, password reset)
NEXTAUTH_URL=http://localhost:3000

# --- Environment mode ---
# Do NOT set NODE_ENV here. Next.js sets it automatically per command
# (`next dev` → development, `next build`/`next start` → production), and
# standalone scripts default to development. Pinning NODE_ENV=development in
# this file forces `npm run build` to emit a mixed dev/prod React runtime and
# the production build fails while prerendering. Leave it unset.
# Set to 'false' to skip content review gate during development.
# When true (default), blocks deployment if any content keys are marked needs_review.
# In development, database connectivity errors are allowed; in production, they block.
CONTENT_REVIEW_GATE_ENABLED=false

# --- PII encryption (REQUIRED in production) ---
# AES-256-GCM key for field-level encryption of passport data (PDPA, doc 12).
# Generate once with: openssl rand -hex 32
# CRITICAL: This key must be IDENTICAL in all environments (local, staging, production).
# If changed or lost once data is encrypted, all encrypted data becomes permanently unreadable.
# See docs/15_deployment.md §4 for full requirements.
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# --- Email (optional in dev: without it, emails log to the console) ---
# Transactional emails (password reset, email verification, etc.) are sent via Resend.
# Get a free API key at https://resend.com
RESEND_API_KEY=
# Default uses Resend's pre-verified test domain (onboarding@resend.dev)
# Once your domain is verified in Resend, set EMAIL_FROM=hello@yourdomain.com
EMAIL_FROM=

# --- OAuth Providers (optional: enable by setting both keys in a pair) ---
# Google OAuth - https://console.cloud.google.com
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Scheduled jobs (REQUIRED in production) ---
# Bearer token protecting /api/cron/* routes; set the same value in Vercel.
# Generate with: openssl rand -hex 24
CRON_SECRET=change-me-generate-with-openssl-rand

# Which scheduler is actually driving /api/cron/* (T-047). Only affects how
# quickly the admin scheduler panel calls a job "silent" — it never changes
# what runs.
#   external      the .github/workflows/scheduler.yml workflow is live, so the
#                 frequent jobs are judged against doc 15's real cadence
#                 (hold expiry 5 min, iCal 15 min) with slack for Actions jitter.
#   vercel-daily  (default, and what an unset value means) only the two daily
#                 Vercel crons run; thresholds stay at two days so a schedule
#                 working as configured is not reported as broken.
# Set this to `external` only once the workflow is confirmed firing.
SCHEDULER_MODE=vercel-daily

# --- Payments (doc 10; optional in dev — leave unset and getPaymentProvider()
# falls back to the mock provider, which is refused if NODE_ENV=production) ---
# Selects the active payment provider. Only "mock" and "opn" are implemented;
# leave unset (defaults to "mock") for local dev.
PAYMENT_PROVIDER=mock
# Opn/Omise (default real provider, Q8) keys. Required only when
# PAYMENT_PROVIDER=opn. Use a test key (skey_test_…) anywhere that is not
# production — a live key (skey_live_…) is refused outside production.
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
# Verifies incoming Opn webhook signatures; required only when PAYMENT_PROVIDER=opn.
OMISE_WEBHOOK_SECRET=

# --- Media storage (optional: without it, uploads fall back to data URIs —
# fine for dev, not for production-scale images) ---
# Vercel Blob read/write token. Leave unset to use the dev fallback.
BLOB_READ_WRITE_TOKEN=

# --- iCal export feed (optional: falls back to SESSION_SECRET/NEXTAUTH_SECRET,
# then a fixed dev-only value; REQUIRED — one of the three — in production) ---
# Signs per-unit iCal feed URLs (P0-5) consumed by Airbnb/Booking.com/Google
# Calendar. Rotating this invalidates every feed link at once.
# Generate with: openssl rand -hex 32
ICAL_FEED_SECRET=

# --- App base URL (optional in dev: defaults to http://localhost:3000) ---
# Used to build absolute URLs for server-side same-origin fetches (e.g. the
# service-order detail page forwarding the caller's session cookie). Set this
# to the deployed origin in staging/production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Ops alerting (optional: unset is a correct no-op, no alerts sent) ---
# Slack/Discord/PagerDuty-compatible incoming webhook URL. Set it and
# unexpected errors (see src/lib/observability.ts) start paging with no code
# change; expected 4xx traffic never pages.
ALERT_WEBHOOK_URL=

# --- Logging (optional; used by the test suite) ---
# Set to "1" to silence structured logs and ops alerts — used by Vitest so
# tests that deliberately exercise failure paths don't bury their own output.
# Leave unset in dev/production.
LOG_SILENT=

# --- Backups (T-048; these are GitHub Actions repository secrets, NOT app env) ---
# Listed here so the full set of secrets the platform depends on is documented
# in one place. The nightly backup workflow reads them; the app never does.
#   BACKUP_DATABASE_URL  A read-everything, change-nothing role — never the
#                        app's own credential. See doc 15 §5:
#                        CREATE ROLE backup_reader LOGIN PASSWORD '<generated>';
#                        GRANT pg_read_all_data TO backup_reader;
#   BACKUP_PASSPHRASE    AES-256 passphrase for the stored dumps. Generate with
#                        openssl rand -base64 48. Lose it and every stored dump
#                        is permanently unreadable — vault it like ENCRYPTION_KEY.
