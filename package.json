{
  "name": "myuno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/repair-failed-migrations.mjs",
    "build": "node scripts/repair-failed-migrations.mjs && prisma generate && node scripts/check-content-review-gate.mjs && next build",
    "db:repair": "node scripts/repair-failed-migrations.mjs",
    "check:content-gate": "node scripts/check-content-review-gate.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:registries": "tsx prisma/seed-registries.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "next": "^14.2.0",
    "open-location-code": "^1.0.3",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.0",
    "@vitest/ui": "^1.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.2.0",
    "eslint-plugin-local-rules": "^3.0.2",
    "jsdom": "^23.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  }
}
