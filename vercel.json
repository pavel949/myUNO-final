{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "regions": ["sin1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/run-frequent",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/run-all",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/import-managed-yandex-media?run=all",
      "schedule": "0 0 * * *"
    }
  ]
}
