 }
 
+// A private receipt for one manual cost. The file never leaves this table in
+// the clear: `ciphertext` is the existing AES-256-GCM contract (lib/encryption)
+// over the base64 bytes, there is no public URL, and the table is closed to the
+// Data API (RLS on, all grants revoked) in the same migration that creates it.
+// At most one receipt is current per expense; a replacement supersedes the old
+// row rather than overwriting it, so what an issued statement cites survives.
+model ExpenseReceipt {
+  id        String   @id @default(uuid())
+  createdAt DateTime @default(now()) @map("created_at")
+
+  ledgerEntryId        String    @map("ledger_entry_id")
+  uploadedByIdentityId String    @map("uploaded_by_identity_id")
+  uploadKey            String    @map("upload_key") @db.VarChar(36)
+  mimeType             String    @map("mime_type")
+  sizeBytes            Int       @map("size_bytes")
+  sha256               String    @db.VarChar(64)
+  ciphertext           String
+  supersededAt         DateTime? @map("superseded_at")
+
+  ledgerEntry    LedgerEntry         @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
+  uploadedBy     Identity            @relation(name: "expenseReceiptUploader", fields: [uploadedByIdentityId], references: [id])
+  statementLines StatementLineItem[]
+
+  @@unique([uploadedByIdentityId, uploadKey])
+  @@index([ledgerEntryId])
+  @@map("expense_receipt")
+}
